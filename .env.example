APP_ENV=development
APP_NAME=ai-seo-clinic
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# Local: postgresql+psycopg://app:app@postgres:5432/ai_seo_clinic
# Production: Supabase transaction/session pooler URL from Dashboard > Connect.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=replace-in-production
APP_ENCRYPTION_KEY=
WORDPRESS_ALLOW_AUTO_PUBLISH=false
LOG_LEVEL=INFO

# Cloudflare R2 (backend-only S3 credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=ai-seo-private
R2_PRESIGNED_URL_TTL_SECONDS=900
R2_MAX_IMAGE_BYTES=26214400
R2_MAX_AUDIO_BYTES=104857600
R2_MAX_VIDEO_BYTES=1073741824

# Browser-facing URL of the deployed FastAPI Vercel project
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
